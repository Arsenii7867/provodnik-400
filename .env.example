# Настройки сервера «Проводник 400». Скопируйте в .env и поправьте под себя.
# Все переменные читает backend/app/config.py, у каждой есть значение по умолчанию.

# Подключение к базе. По умолчанию SQLite в backend/data, путь относительно папки backend.
# Для PostgreSQL из compose: postgresql+psycopg://provodnik:provodnik@postgres:5432/provodnik
DATABASE_URL=sqlite:///./data/provodnik.db

# Папка со сценариями и справочниками (YAML), относительно папки backend.
CONTENT_DIR=../content

# 1: при старте на пустой базе создать демо-депо, бригады и синтетических сотрудников.
AUTO_SEED=1

# dev, test или prod. В prod обязателен INTEGRATION_API_KEY, демо-ключ по умолчанию не действует.
APP_ENV=dev

# Разрешённые источники для CORS через запятую (нужны только для vite dev на 5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ключ для HR и LMS (заголовок X-API-Key). Вне prod по умолчанию demo-integration-key.
INTEGRATION_API_KEY=demo-integration-key

# Собранный фронт, который сервер раздаёт на своём порту; путь относительно папки backend.
FRONTEND_DIST=../frontend/dist

# Срок жизни токена входа в часах.
TOKEN_TTL_HOURS=12

# Допуск в секундах при проверке серверного таймера: сетевая задержка не должна засчитываться как
# опоздание. Окно двустороннее (истечение принимается на столько же раньше срока), поэтому больше
# пяти секунд сервер не принимает.
TIMER_GRACE_SECONDS=1.0

# Лимит неудачных попыток входа в минуту с одного адреса.
LOGIN_RATE_PER_MINUTE=10

# PIN демо-аккаунтов при создании синтетических сотрудников.
DEMO_PIN=1234
